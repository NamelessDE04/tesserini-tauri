rules_version = '2';
// Regole di sicurezza Firestore per Tesserini Tauri.
// Da incollare in console Firebase → Firestore Database → Regole → Pubblica.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vaisittiluca@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function myUser() {
      return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data;
    }

    // istruttore = utente approvato a cui l'amministratore ha dato il permesso di assegnare i brevetti
    function isInstructor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/utenti/$(request.auth.uid))
        && myUser().stato == 'approvato'
        && myUser().get('istruttore', false) == true;
    }

    function canStamp() {
      return isAdmin() || isInstructor();
    }

    function isApproved() {
      return isAdmin() || (request.auth != null
        && exists(/databases/$(database)/documents/utenti/$(request.auth.uid))
        && get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data.stato == 'approvato');
    }

    // Utenti e richieste di accesso
    match /utenti/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      // chiunque si registri entra "in attesa"; solo l'amministratore può approvare
      allow create: if request.auth != null && request.auth.uid == uid
        && (isAdmin() || request.resource.data.stato == 'in_attesa')
        && request.resource.data.keys().hasOnly(['email', 'nome', 'stato', 'richiestoIl']);
      allow update, delete: if isAdmin();
    }

    // Archivio condiviso dei tesserini: solo utenti approvati.
    // I brevetti (timbri) li assegnano o tolgono solo amministratore e istruttori.
    match /tessere/{id} {
      allow read: if isApproved();
      allow create: if isApproved()
        && (canStamp() || request.resource.data.get('brevetti', {}).size() == 0);
      allow update: if isApproved()
        && (canStamp() || request.resource.data.get('brevetti', {}) == resource.data.get('brevetti', {}));
      allow delete: if isAdmin()
        || (isApproved() && resource.data.get('brevetti', {}).size() == 0);
    }

    // Addestramento: contenuti dei percorsi (li modificano amministratore e istruttori)
    match /percorsi/{bid} {
      allow read: if isApproved();
      allow write: if canStamp();
    }

    // Progressi dell'allievo (schede lette, tentativi del test): li scrive l'allievo stesso
    match /progressi/{uid} {
      allow read: if canStamp() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isApproved() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Esercizi pratici convalidati: solo amministratore e istruttori
    match /validazioni/{uid} {
      allow read: if canStamp() || (request.auth != null && request.auth.uid == uid);
      allow write: if canStamp();
    }
  }
}
